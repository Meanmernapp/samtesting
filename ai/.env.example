# Accept Coqui XTTS license (required)
COQUI_TOS_AGREED=1

# Server
VOICEAI_HOST=0.0.0.0
VOICEAI_PORT=8000
VOICEAI_DATA_DIR=./data

# Pre-load XTTS on startup (slower boot, faster first request)
VOICEAI_WARMUP=false

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
